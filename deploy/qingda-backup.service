[Unit]
Description=青答 Qingda 日备与恢复校验
After=qingda-web.service

[Service]
Type=oneshot
WorkingDirectory=/opt/qingda
Environment=PYTHONPATH=/opt/qingda/backend
Environment=APP_ROOT=/opt/qingda
EnvironmentFile=/opt/qingda/.env
ExecStart=/opt/qingda/.venv/bin/python /opt/qingda/deploy/server.py backup
UMask=0077
