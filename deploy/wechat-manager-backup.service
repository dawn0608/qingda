[Unit]
Description=Wechat management online backup and restore check
After=wechat-manager-web.service

[Service]
Type=oneshot
WorkingDirectory=/opt/wechat-manager
Environment=PYTHONPATH=/opt/wechat-manager/backend
Environment=APP_ROOT=/opt/wechat-manager
EnvironmentFile=/opt/wechat-manager/.env
ExecStart=/opt/wechat-manager/.venv/bin/python /opt/wechat-manager/deploy/server.py backup
UMask=0077
