[Unit]
Description=WechatApi management web and durable callback
After=network.target postgresql@17-main.service
Requires=postgresql@17-main.service

[Service]
User=wechat-manager
Group=wechat-manager
WorkingDirectory=/opt/wechat-manager
Environment=PYTHONPATH=/opt/wechat-manager/backend
Environment=APP_ROOT=/opt/wechat-manager
EnvironmentFile=/opt/wechat-manager/.env
ExecStart=/opt/wechat-manager/.venv/bin/python -m wechat_manager serve
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wechat-manager
LimitNOFILE=2048

[Install]
WantedBy=multi-user.target
