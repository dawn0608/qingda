DATABASE_URL=postgresql://wechat_manager_app:CHANGE_ME@127.0.0.1:5432/wechat_manager
# 唯一环境模板；本地复制为根 .env，生产在同一项目根配置。
PUBLIC_URL=http://127.0.0.1:17950
WEB_BIND_HOST=127.0.0.1
WEB_TRUSTED_PROXY_IPS=127.0.0.1
COOKIE_SECURE=false
# 阿里云号码认证服务（Dypnsapi），仅服务端读取 RAM 凭据。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 可选；发送与核验使用同一方案，最多 20 个字符。
ALIYUN_SMS_SCHEME_NAME=
DATA_DIR=data
MASTER_KEY_FILE=data/master.key
TZ=Asia/Shanghai
# 运维保留规则；发布与每日备份共用，关键原始备份单独保护。
BACKUP_RELEASE_KEEP=0
BACKUP_DAILY_KEEP=7
BACKUP_TRANSIENT_TTL_HOURS=24
# 附件 API 单文件上限 100MiB，非 SILK 语音校验及标准化使用 FFmpeg；前端仅文本回复。
FFMPEG_BINARY=ffmpeg
# 语音固定阿里百炼 qwen-audio-3.1-asr-flash；API Key 在前端按用户加密保存，无共享环境凭据。

# 生产使用 HTTPS 与安全 Cookie，密钥文件须由专属服务账号读取。
# PUBLIC_URL=https://example.com
# WEB_BIND_HOST=127.0.0.1
# WEB_TRUSTED_PROXY_IPS=127.0.0.1
# COOKIE_SECURE=true
# DATA_DIR=/var/lib/qingda
# MASTER_KEY_FILE=/etc/qingda/master.key

WECHAT_API_BASE=https://wechatapi.net/finder/v2/api
# 微信 Token 和 DeepSeek 密钥由用户在系统设置中填写，加密存储于 PostgreSQL。

# 和风天气 API Host 和 Key 由各用户在系统设置中填写，无共享环境兜底。


# 首次验证码登录自动注册开关；关闭仅禁止创建新用户。邮件使用SMTP TLS。
AUTH_REGISTRATION_ENABLED=true
# 验证码发送滚动窗口，跨登录和联系方式绑定累计。
AUTH_CODE_INTERVAL_SECONDS=60
AUTH_CODE_TARGET_HOURLY_LIMIT=5
AUTH_CODE_TARGET_DAILY_LIMIT=10
AUTH_CODE_IP_HOURLY_LIMIT=10
AUTH_CODE_IP_DAILY_LIMIT=30
AUTH_REQUEST_IP_PER_MINUTE=30
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS=ssl
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# 仅填写审核通过后的真实备案号；未配置时不展示。
ICP_FILING_NUMBER=
PUBLIC_SECURITY_FILING_NUMBER=
PUBLIC_SECURITY_FILING_URL=
