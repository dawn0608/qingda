            "content": "验收编号Q789",
            "role": "user"
          }
        }
      ],
      "expected": "Q789"
    },
    {
      "id": "preserve-original-emotion-code",
      "history": [],
      "current_messages": [
        {
          "content": "请原样复述冒号后的内容：[微笑]",
